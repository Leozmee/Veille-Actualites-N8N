<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.leogallus.veille-presse</string>

  <!-- Réveil quotidien à 8 h. Le script ne fait rien tant que 3 jours ne se
       sont pas écoulés : c'est ce qui permet de rattraper une exécution
       manquée sans jamais la dupliquer. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/leogallus/Projets/veille-presse-n8n/lancer-veille.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/veille-presse.out</string>
  <key>StandardErrorPath</key><string>/tmp/veille-presse.err</string>
</dict>
</plist>
